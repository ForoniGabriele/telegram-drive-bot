# Telegram Bot Token (从 @BotFather 获取)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 超级管理员的 Telegram user_id
OWNER_ID=123456789

# 是否启用频道存储模式 (可选, 默认 true)
# true: 文件转发到存储频道保存, 取回时从频道复制 (更可靠)
# false: 直接使用 Telegram file_id 发送文件 (更轻量, 无需存储频道)
USE_CHANNEL_STORAGE=true

# 删除文件时是否同步清理存储频道里的副本消息 (可选, 默认 true)
# 删除流程是 "先提交 DB 事务, 再尽力清理频道副本":
# true:  DB 记录删除成功后, 尝试删除每个频道里的副本消息. 失败仅记录 WARN 日志,
#        不回滚 DB — 从用户视角文件已删除, 频道里可能残留孤儿副本, 需要时手工清理.
# false: 仅清理数据库记录, 频道副本保留 (适合将频道当作归档).
# 该配置对 direct 模式无影响.
DELETE_CHANNEL_COPIES=true

# 存储频道/超级群组的 chat_id 列表, 以逗号分隔 (以 -100 开头)
# 当 USE_CHANNEL_STORAGE=true 时必填, false 时可选
# 第一个为主副本, 后续为冗余副本. 每个新文件会同时写入所有可用频道, 任一成功即视为保存成功
# 取回时按顺序尝试每个副本, 全失败时自动降级使用 file_id 直发
# 单频道写法: STORAGE_CHAT_IDS=-1001234567890
# 多频道写法: STORAGE_CHAT_IDS=-1001234567890,-1009876543210
STORAGE_CHAT_IDS=-1001234567890

# 存储频道健康追踪 (可选)
# 单频道连续失败达到 STORAGE_FAILURE_LIMIT 次后, 进入 STORAGE_COOLDOWN_PERIOD
# 冷却期, 期间跳过不用. 冷却期结束后自动恢复. 成功一次即重置失败计数.
# STORAGE_FAILURE_LIMIT 默认 3
# STORAGE_COOLDOWN_PERIOD 默认 5m (Go duration: 30s / 5m / 1h)
# STORAGE_FAILURE_LIMIT=3
# STORAGE_COOLDOWN_PERIOD=5m

# 异步频道操作 (可选, 默认 false)
# 默认行为是同步: 存入时先转发到所有频道再写数据库, 删除时先删数据库再删频道副本.
# 启用异步后, 频道操作放到后台 goroutine 执行, 用户无需等待频道 I/O, 响应更快.
# 异步模式下频道操作为尽力而为 (best-effort), 失败仅记录日志不影响用户.
#
# ASYNC_FORWARD: 仅当 USE_CHANNEL_STORAGE=true 时生效
#   true:  先写 files 表 → 立即返回成功 → 后台转发到频道并写 file_copies
#          最坏情况: 频道副本缺失, 取文件时自动降级为 file_id 直发
# ASYNC_DELETE: 仅当 USE_CHANNEL_STORAGE=true 且 DELETE_CHANNEL_COPIES=true 时生效
#   true:  先删数据库记录 → 立即返回成功 → 后台删除频道副本消息
#          最坏情况: 频道内残留孤儿消息, 需手工清理
# ASYNC_FORWARD=false
# ASYNC_DELETE=false

# PostgreSQL 连接串 (支持 Supabase)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# 数据库连接池 (可选)
# 对远程数据库 (如 Supabase) 比较重要 —— 开连接是有限资源且首次握手有延迟.
# 默认值对 Supabase free tier (~15 conn 配额) 友好, 预留给 psql 手动会话的空间.
# DB_MAX_OPEN_CONNS=10         # 最大并发连接数
# DB_MAX_IDLE_CONNS=5          # 保持温热的空闲连接数 (不得大于 MAX_OPEN_CONNS)
# DB_CONN_MAX_LIFETIME=30m     # 连接强制回收年龄 (防御僵死 TCP)
# DB_CONN_MAX_IDLE_TIME=5m     # 连接空闲多久后关闭

# 日志配置 (可选)
# LOG_FORMAT  text (默认, 适合本地开发) | json (适合日志采集)
# LOG_LEVEL   debug | info (默认) | warn | error
# LOG_FORMAT=text
# LOG_LEVEL=info

# 代理配置 (可选, 留空则不使用代理)
# 支持 SOCKS5 和 HTTP 代理
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=socks5://user:pass@127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:7890

# ===== 向量搜索 (可选功能) =====
# 启用后, 搜索时优先使用 AI 语义搜索, 失败再降级到全文/模糊搜索.
# 文件保存后会异步调用 Embedding API 生成向量, 不影响用户交互延迟.
# VECTOR_SEARCH_ENABLED=false

# 以下仅当 VECTOR_SEARCH_ENABLED=true 时生效 (必填):

# API 类型 (可选, 默认 openai)
# openai: OpenAI 兼容 API (支持 dimensions 参数, 如 text-embedding-3-small)
# gemini: Google Gemini 原生 API (使用 outputDimensionality 参数, 如 gemini-embedding-2)
# EMBEDDING_API_TYPE=openai

# Embedding API 配置
# EMBEDDING_BASE_URL=https://api.openai.com/v1                       # OpenAI
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta # Gemini
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small

# 向量维度 (可选, 默认 256, 需与模型输出匹配)
# 推荐 256 — 对短文本 (文件名 + caption) 足够, 且节省存储空间
# EMBEDDING_DIMENSIONS=256

# 向量搜索阈值 (可选, 默认 0.4)
# 余弦距离的最大允许值, 范围 0.0 ~ 2.0. 值越小越严格, 超出该距离的结果将被忽略.
# EMBEDDING_THRESHOLD=0.4

# ===== 后台维护任务 (可选) =====

# 定时 caption 同步周期 (可选, 默认关闭)
# Telegram 媒体组 (media group) 的 caption 通常只附在组里第一条消息上, 其他消息 caption 为空.
# /cap_sync 会扫描媒体组并将首条消息的 caption 回填到同组其他消息. 该任务也可手动触发 (owner 命令).
# 留空 / 不设置 = 关闭后台任务 (此时仍可手动跑 /cap_sync).
# 设置正值 = 启用后台 ticker, 每隔该周期跑一次 caption sync. 
# 与手动 /cap_sync 共享互斥锁, 不会并发. 内部为单事务 SQL, 通常 < 1 秒, 资源占用极低.
# 推荐值: 30m ~ 1h
# CAP_SYNC_INTERVAL=30m
